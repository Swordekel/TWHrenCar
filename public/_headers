# semua halaman dan berkas (Cloudflare Workers static assets; dulu bagian "headers" di vercel.json).
# cloudflareinsights: beacon Web Analytics yang bisa disisipkan Cloudflare. Peta Google dimuat saat diklik (frame-src).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src https://www.google.com https://maps.google.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  # HSTS: setahun selalu https (juga di jawaban Worker, worker/index.js denganHsts)
  Strict-Transport-Security: max-age=31536000

# gambar memakai penanda versi ?v= dari isi berkas (bangun.mjs), begitu juga styles.css dan app.js
/assets/*
  Cache-Control: public, max-age=2592000

/styles.css
  Cache-Control: public, max-age=2592000

/app.js
  Cache-Control: public, max-age=2592000

# font tidak pernah berubah isinya (nama berkas baru bila diganti)
/assets/font/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# panel admin: foto yang dipilih untuk diunggah ditampilkan dari blob:, pratinjau situs dalam iframe dari situs sendiri;
# tidak pernah disimpan cache lama dan tidak boleh dibingkai situs lain
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
  Cache-Control: no-cache
  X-Robots-Tag: noindex
